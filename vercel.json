{
  "version": 2,
  "crons": [
    {
      "path": "/health",
      "schedule": "0 */12 * * *"
    }
  ],
  "builds": [
    {
      "src": "public/**",
      "use": "@vercel/static"
    },
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/img/(.*)",
      "dest": "public/img/$1"
    },
    {
      "src": "/styles.css",
      "dest": "public/styles.css"
    },
    {
      "src": "/favicon\\.(ico|png)",
      "dest": "public/img/favicon.$1"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
